# yamllint configuration, used by the Yetus yamllint plugin in the precommit.
extends: default

rules:
  # Same limit as the Java code (checkstyle and spotless).
  line-length:
    max: 100
  # GitHub workflow files do not start with "---".
  document-start: disable
